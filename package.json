{
  "name": "beta-car",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "dev": "node scripts/serve.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:firebase": "npm run build && firebase emulators:exec --project demo-beta-car --only auth,firestore,storage,functions,hosting \"node --test tests/firebase/*.test.js\"",
    "firebase:emulators": "node scripts/firebase/emulators.mjs",
    "firebase:deploy": "node scripts/firebase/deploy.mjs",
    "firebase:seed": "node scripts/firebase/seed.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "firebase-tools": "15.34.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
