{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node -e 'const f=require('\"'\"'node:fs'\"'\"');f.mkdirSync('\"'\"'.build'\"'\"',{recursive:true});[\"sayfa.html\", \"admin.html\", \"firmalar.html\", \"talepler.html\", \"index.html\", \"hesabim.html\", \"ilanlar.html\", \"yazilar.html\", \"degerleme.html\", \"giris.html\", \"404.html\", \"ilan-ver.html\", \"model.html\", \"mesajlar.html\", \"ilan.html\", \"firma.html\", \"foto.html\", \"paketler.html\", \"karsilastir.html\", \"style.css\", \"app.js\", \"logo.png\", \"manifest.json\", \"robots.txt\", \"sitemap.xml\"].forEach(p=>f.copyFileSync(p,'\"'\"'.build/'\"'\"'+p))'",
  "outputDirectory": ".build",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/kullanilmis",
      "destination": "/ilanlar.html?kategori=kullanilmis"
    },
    {
      "source": "/sifir",
      "destination": "/ilanlar.html?kategori=sifir"
    },
    {
      "source": "/parca",
      "destination": "/ilanlar.html?kategori=parca"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
